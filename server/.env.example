NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/realtime-chat
# Optional comma-separated DNS server IPs for MongoDB SRV lookups, e.g. 8.8.8.8,8.8.4.4
# MONGODB_DNS_SERVERS=
ACCESS_TOKEN_SECRET=replace-with-a-random-access-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
